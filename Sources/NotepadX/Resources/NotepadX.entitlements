<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Phase 6 OneDrive 폴더 선택(NSOpenPanel)과 파일 내보내기(DOCX/PDF 등 저장 패널)에 필요 -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Phase 7 OpenAI API 및 Phase 6.2 Microsoft Graph 통신에 필요 -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Phase 6 보안 스코프 북마크(OneDrive 동기화 폴더 재접근)에 필요 -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <!-- 홈 화면 위젯이 읽는 최근 메모 요약 JSON을 쓴다(WidgetSnapshotStore). 위젯은 별도 샌드박스
         프로세스라 컨테이너 밖의 이 폴더로만 데이터를 주고받을 수 있다. 이 경로는
         NotepadXWidget.entitlements, WidgetSnapshotStore.homeRelativePath와 같아야 한다. -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
    <array>
        <string>/Library/Application Support/NotepadXWidget/</string>
    </array>
</dict>
</plist>
